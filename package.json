{
  "name": "rise-translate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "translation:worker": "node --env-file-if-exists=.env.local --import tsx src/server/translation/run-worker.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preflight": "node --env-file-if-exists=.env.local --import tsx scripts/preflight.ts",
    "deployment:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/deployment-smoke.ts",
    "livekit:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/livekit-smoke.ts",
    "openai:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/openai-smoke.ts",
    "supabase:schema:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/supabase-schema-smoke.ts",
    "recording:storage:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/recording-storage-smoke.ts",
    "translation:worker:smoke": "TRANSLATION_WORKER_MAX_ITERATIONS=1 TRANSLATION_WORKER_IDLE_DELAY_MS=10 pnpm translation:worker",
    "liveqa:check": "node --import tsx scripts/live-qa-check.ts",
    "env:manifest": "node --import tsx scripts/runtime-env-manifest.ts",
    "env:check": "node --env-file-if-exists=.env.local --import tsx scripts/runtime-env-check.ts",
    "env:template": "node --import tsx scripts/runtime-env-template.ts",
    "completion:audit": "node --import tsx scripts/completion-audit.ts",
    "readiness:next": "node --env-file-if-exists=.env.local --import tsx scripts/readiness-next.ts",
    "production:check": "pnpm verify && pnpm preflight && pnpm env:check web && pnpm env:check worker && pnpm deployment:smoke && pnpm deployed:preflight && pnpm livekit:smoke && pnpm openai:smoke && pnpm supabase:schema:smoke && pnpm recording:storage:smoke && pnpm translation:worker:smoke && pnpm translation:worker:status",
    "readiness:check": "pnpm production:check && pnpm liveqa:check",
    "readiness:report": "node --import tsx scripts/readiness-report.ts",
    "deployed:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/deployed-preflight.ts",
    "vercel:env:sync": "node --import tsx scripts/vercel-env-sync.ts",
    "translation:worker:supervisor": "node --env-file-if-exists=.env.local --import tsx scripts/translation-worker-supervisor.ts",
    "translation:worker:start": "pnpm translation:worker:supervisor start",
    "translation:worker:status": "pnpm translation:worker:supervisor status",
    "translation:worker:stop": "pnpm translation:worker:supervisor stop",
    "recording:storage:configure": "node --env-file-if-exists=.env.local --import tsx scripts/recording-storage-configure.ts",
    "recording:storage:finalize": "node --env-file-if-exists=.env.local --import tsx scripts/recording-storage-finalize.ts",
    "liveqa:plan": "node --env-file-if-exists=.env.local --import tsx scripts/live-qa-plan.ts",
    "liveqa:evidence:init": "node --env-file-if-exists=.env.local --import tsx scripts/live-qa-evidence-init.ts",
    "liveqa:evidence:commands": "node --env-file-if-exists=.env.local --import tsx scripts/live-qa-evidence-commands.ts",
    "cost:estimate": "node --import tsx scripts/cost-estimate.ts",
    "recording:storage:setup": "node --env-file-if-exists=.env.local --import tsx scripts/recording-storage-setup.ts",
    "pilot:check": "node --env-file-if-exists=.env.local --import tsx scripts/pilot-check.ts",
    "recording:storage:prompt": "node --import tsx scripts/recording-storage-prompt.ts"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/rtc-node": "0.13.27",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "livekit-client": "^2.18.9",
    "livekit-server-sdk": "^2.15.2",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.30.3"
}
