# App
# Local dev may use http://localhost:3000. Production must use the public HTTPS origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY_BASE64=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit
# Production clients/workers should use a secure wss:// LiveKit URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=12h


# Recording storage for LiveKit Egress (Supabase Storage S3-compatible keys or another S3-compatible store)
LIVEKIT_RECORDING_S3_BUCKET=recordings
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET_KEY=
LIVEKIT_RECORDING_S3_REGION=auto
# Optional. Leave blank to derive ${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/s3.
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_FORCE_PATH_STYLE=true

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_NOTES_MODEL=

# Internal worker auth
INTERNAL_WORKER_TOKEN=
# true only for local scaffold smoke tests; production must use a real media adapter
TRANSLATION_WORKER_DRY_RUN=false
# livekit-node enables the server-side LiveKit mic-track -> OpenAI Realtime -> translated LiveKit audio-track worker
TRANSLATION_WORKER_ADAPTER=livekit-node
# Optional bounded smoke-test settings; leave unset for a long-running production worker
TRANSLATION_WORKER_MAX_ITERATIONS=
TRANSLATION_WORKER_IDLE_DELAY_MS=
TRANSLATION_WORKER_ERROR_DELAY_MS=
